# Core App Configuration
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=order-service
TAX_PERCENT=5

# Databases & Cache
DATABASE_URL=postgres://localhost:5432/spotq_order_db
REDIS_URL=redis://localhost:6379

# RabbitMQ Messaging
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE_ORDER_EVENTS=order-events

# S2S Authentication
S2S_SERVICE_NAME=order-service
ORDER_S2S_PRIVATE_KEY=

# Downstream S2S Services
RESTAURANT_SERVICE_URL=http://restaurant-service:3001
RESTAURANT_SERVICE_TIMEOUT_MS=5000
S2S_RESTAURANT_AUDIENCE=restaurant-service

QUEUE_SERVICE_URL=http://queue-service:3004
QUEUE_SERVICE_TIMEOUT_MS=5000
S2S_QUEUE_AUDIENCE=queue-service

PAYMENT_SERVICE_URL=http://payment-service:3003
PAYMENT_SERVICE_TIMEOUT_MS=5000
S2S_PAYMENT_AUDIENCE=payment-service

# Circuit Breaker Configuration (@spotq-org/circuit-breaker)
CIRCUIT_BREAKER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
CIRCUIT_BREAKER_ROLLING_WINDOW_MS=10000
