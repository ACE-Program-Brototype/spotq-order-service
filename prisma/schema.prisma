// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  PRE_ORDER
  DINE_IN
  TAKEAWAY
}

enum PaymentMode {
  ONLINE
  COD
  PAY_AT_COUNTER
}

enum PaymentStatus {
  PENDING
  PAID
  PAID_OFFLINE
  REFUNDED
  FAILED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model Cart {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items CartItem[]

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("carts")
}

model CartItem {
  id                  String   @id @default(uuid()) @db.Uuid
  cartId              String   @map("cart_id") @db.Uuid
  menuItemId          String   @map("menu_item_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  quantity            Int      @default(1)
  specialInstructions String?  @map("special_instructions")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart   Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  addons CartItemAddon[]

  @@index([cartId])
  @@map("cart_items")
}

model CartItemAddon {
  id         String @id @default(uuid()) @db.Uuid
  cartItemId String @map("cart_item_id") @db.Uuid
  addonId    String @map("addon_id") @db.Uuid

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_addons")
}

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  orderNumber         String        @unique @map("order_number") @db.VarChar(50)
  restaurantId        String        @map("restaurant_id") @db.Uuid
  userId              String?       @map("user_id") @db.Uuid
  userName            String?       @map("user_name") @db.VarChar(255)
  userPhone           String?       @map("user_phone") @db.VarChar(20)
  tableId             String?       @map("table_id") @db.Uuid
  tableNumber         Int?          @map("table_number")
  queueEntryId        String?       @map("queue_entry_id") @db.Uuid
  paymentId           String?       @map("payment_id") @db.Uuid
  orderType           OrderType     @default(PRE_ORDER) @map("order_type")
  paymentMode         PaymentMode   @default(ONLINE) @map("payment_mode")
  paymentStatus       PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus         OrderStatus   @default(PLACED) @map("order_status")
  subtotal            Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  platformFee         Decimal       @default(0.00) @map("platform_fee") @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  couponCode          String?       @map("coupon_code") @db.VarChar(50)
  grandTotal          Decimal       @default(0.00) @map("grand_total") @db.Decimal(10, 2)
  estimatedReadyAt    DateTime?     @map("estimated_ready_at") @db.Timestamptz(3)
  specialInstructions String?       @map("special_instructions")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([restaurantId, orderStatus])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  menuItemId          String  @map("menu_item_id") @db.Uuid
  itemName            String  @map("item_name") @db.VarChar(255)
  variantId           String? @map("variant_id") @db.Uuid
  variantName         String? @map("variant_name") @db.VarChar(100)
  quantity            Int     @default(1)
  unitPrice           Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice          Decimal @map("total_price") @db.Decimal(10, 2)
  specialInstructions String? @map("special_instructions")

  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addons OrderItemAddon[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemAddon {
  id          String  @id @default(uuid()) @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  addonId     String  @map("addon_id") @db.Uuid
  addonName   String  @map("addon_name") @db.VarChar(100)
  price       Decimal @default(0.00) @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_addons")
}

model OrderStatusHistory {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  currentStatus  OrderStatus  @map("current_status")
  changedBy      String       @map("changed_by") @db.VarChar(255)
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}
